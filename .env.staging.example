# Copiar como .env en el servicio de staging. No guardar secretos reales aquí.
ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg2://staging_user:replace-me@staging-db:5432/atlas_staging
ALLOWED_ORIGINS=["https://localhost"]

# Carrera se habilita solamente en staging y con un único proceso/instancia.
RACE_MODE_ENABLED=true
RACE_INVITE_BASE_URL=https://staging-api.replace-me.example
ANDROID_APP_LINK_PACKAGE_NAME=com.enmanuelotero.atlasflags.staging
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINT=AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA

# BASE_URL continúa siendo el destino web de verificación de cuentas.
BASE_URL=https://staging.replace-me.example
VERIFICATION_LINK=https://staging.replace-me.example/verify-email?token=
SMTP_SERVER=smtp.replace-me.example
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
SENDER_EMAIL=staging@replace-me.example
SENDER_PASSWORD=replace-me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DAILY_MAX_ATTEMPTS=4

# Omitir en una sola instancia. Configurar rediss:// antes de usar réplicas.
# RATE_LIMIT_STORAGE_URI=rediss://replace-me
