# Copiar como .env y reemplazar todos los valores antes de desplegar.
ENV=development
SECRET_KEY=development-only-change-this-secret-key
DATABASE_URL=postgresql+psycopg2://usuario:contrasena@localhost:5432/banderas

# JSON válido. Para Android/Capacitor se necesita https://localhost.
ALLOWED_ORIGINS=["http://localhost:5173","https://localhost"]
BASE_URL=http://127.0.0.1:5500
RACE_MODE_ENABLED=false
RACE_INVITE_BASE_URL=https://atlas-flags-api.example.com
# Huella SHA-256 de Play App Signing, formato AA:BB:CC:...
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINT=
ANDROID_APP_LINK_PACKAGE_NAME=com.enmanuelotero.atlasflags
# Opcional: Redis comparte los límites entre instancias. Para una primera
# versión puede omitirse y usar memoria local. rediss:// cifra el enlace
# cuando se conecta por Internet público.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=2880
DAILY_MAX_ATTEMPTS=4

# Obligatorios en producción: sin correo de verificación la cuenta no puede
# iniciar sesión ni publicar resultados.
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SENDER_EMAIL=no-reply@example.com
SENDER_PASSWORD=replace-me
VERIFICATION_LINK=https://example.com/verify-email?token=
